# Copy OUTSIDE the repository/build context into your secret management system.
# Production refuses these placeholder values. No live provider activation is supported.
NODE_ENV=production
DATABASE_URL=postgresql://runtime:REPLACE_PASSWORD@db.example.invalid:5432/commerce?sslmode=verify-full
DB_SSL_MODE=url
# For private CA: mount certificates securely and use documented Phase 2 TLS settings.
JWT_ACCESS_SECRET=replace-with-an-independent-private-signing-secret
# Optional JWT_ISSUER / JWT_AUDIENCE require coordinated issuance/verification rollout.
CORS_ORIGINS=https://shop.example.invalid
TRUST_PROXY=false
# TRUST_PROXY_CIDRS=exact-ingress-CIDRs
ENABLE_API_DOCS=false
RATE_LIMIT_STORE=postgres
OPS_METRICS_TOKEN=replace-with-independent-private-operational-token
WORKER_OPS_PORT=3001
OPS_BIND_HOST=0.0.0.0
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=30000
UPLOAD_DIR=/app/uploads
UPLOAD_BASE_URL=https://assets.example.invalid/uploads
PAYMENT_PROVIDER=NONE
# MYFATOORAH_ENV=sandbox (only supported environment; separate verified sandbox credentials)
# MYFATOORAH_API_VERSION=v2
# MYFATOORAH_ACCOUNT_COUNTRY=KWT
# MYFATOORAH_ACCOUNT_CURRENCY=KWD
# MYFATOORAH_API_TOKEN=REPLACE_SANDBOX_TOKEN
# MYFATOORAH_WEBHOOK_SECRET=REPLACE_SANDBOX_WEBHOOK_SECRET
# MYFATOORAH_CALLBACK_URL=https://staging.example.invalid/payment-return
# MYFATOORAH_ERROR_URL=https://staging.example.invalid/payment-error
WORKER_POLL_MS=1000
WORKER_CONCURRENCY=2
WORKER_SCAN_BATCH=100
WORKER_LEASE_MS=60000
WORKER_MAX_ATTEMPTS=12
WORKER_RETRY_BASE_MS=5000
WORKER_RETRY_MAX_MS=900000
WORKER_INITIATION_GRACE_MS=120000
RESERVATION_TTL_SECONDS=900
# Migration job ONLY: separate DDL role/URL, never grant DDL to runtime roles.
# MIGRATION_APPROVED=true
# MIGRATION_BACKUP_VERIFIED=true
# EXPECTED_DATABASE_HOST=db.example.invalid
# EXPECTED_DATABASE_NAME=commerce
