// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum UserRole {
  CUSTOMER
  ADMIN
  MANAGER
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT

  @@map("DiscountType")
}

enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  RESERVATION
  RELEASE
  SALE
}

model User {
  specialOrderRequests SpecialOrderRequest[]

  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  firstName    String
  lastName     String

  role UserRole @default(CUSTOMER)

  isActive Boolean @default(true)

  emailVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  productReviews ProductReview[]

  carts        Cart[]
  wishlists    Wishlist[]
  addresses    Address[]
  orders       Order[]
  couponUsages CouponUsage[]

  checkoutRequests CheckoutRequest[]
  passwordChangeRequests PasswordChangeRequest[]

  notifications Notification[]
  devices       UserDevice[]

  defaultCountryCode String?
  defaultCountry Country? @relation(  fields: [defaultCountryCode],  references: [code],  onDelete: SetNull)

  tenantMemberships TenantMember[]

  requestedPaymentRefunds PaymentRefund[] @relation("PaymentRefundRequestedBy")
  resolvedPaymentRefundConflicts PaymentRefundConflictAudit[] @relation("PaymentRefundConflictResolvedBy")

}

model EmailVerificationToken {
  id     String @id @default(uuid())
  userId String

  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}


model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  familyId          String
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id     String @id @default(uuid())
  userId String

  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id String @id @default(uuid())

  tenantId String

  name        String
  slug        String
  description String?

  imageStorageKey String?
  imageUrl        String?

  isActive Boolean @default(true)

  parentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation( fields: [tenantId],  references: [id], onDelete: Cascade)

  parent Category? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)

  children Category[] @relation("CategoryHierarchy")

  products Product[]

  complementarySources CategoryComplementaryRelation[] @relation("ComplementarySourceCategory")
  complementaryTargets CategoryComplementaryRelation[] @relation("ComplementaryTargetCategory")

  @@unique([tenantId, id])
  @@unique([tenantId, slug])

  @@index([tenantId])
  @@index([tenantId, parentId])
  @@index([tenantId, isActive])
  @@index([isActive])
  @@index([parentId])

  promotionSelectors PromotionSelector[]
}

model CategoryComplementaryRelation {
  id String @id @default(uuid())

  tenantId         String
  sourceCategoryId String
  targetCategoryId String
  sortOrder        Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceCategory Category @relation("ComplementarySourceCategory", fields: [tenantId, sourceCategoryId], references: [tenantId, id], onDelete: Cascade)
  targetCategory Category @relation("ComplementaryTargetCategory", fields: [tenantId, targetCategoryId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, sourceCategoryId, targetCategoryId])
  @@index([tenantId, sourceCategoryId, sortOrder, targetCategoryId])
  @@index([tenantId, targetCategoryId])
}

model Brand {
  id String @id @default(uuid())

  tenantId String

  name        String
  slug        String
  description String?

  imageStorageKey String?
  imageUrl        String?

  isActive Boolean @default(true)

  tenant Tenant @relation( fields: [tenantId],  references: [id], onDelete: Cascade )

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([tenantId, slug])

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([isActive])

  promotionSelectors PromotionSelector[]

  @@unique([tenantId, id])
}

model Product {
  specialOrderRequestItems SpecialOrderRequestItem[]

  id          String        @id @default(uuid())
  name        String
  slug        String
  description String?
  status      ProductStatus @default(DRAFT)

  tenantId String

  categoryId String
  brandId    String?

  // Product-level fallback price.
  // A variant may override this price.
  basePrice Decimal @db.Decimal(14, 4)

  taxCategoryId String?

  // Product-level discount.
  discountType     DiscountType?
  discountValue    Decimal?      @db.Decimal(14, 4)
  discountStartsAt DateTime?
  discountEndsAt   DateTime?

  images ProductImage[]

  attributes    ProductAttribute[]
  variants      ProductVariant[]
  collections   ProductCollectionItem[]
  wishlistItems WishlistItem[]

  reviews ProductReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation( fields: [tenantId], references: [id],  onDelete: Cascade )
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  brand Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)

  taxCategory TaxCategory? @relation(fields: [taxCategoryId], references: [id], onDelete: Restrict)

  @@unique([tenantId, slug])

  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@index([tenantId, brandId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])

  @@index([brandId])
  @@index([categoryId])
  @@index([createdAt])
  @@index([status])

  promotionSelectors PromotionSelector[]

  @@unique([tenantId, id])
}

model ProductImage {
  id         String  @id @default(uuid())
  productId  String
  storageKey String
  url        String
  altText    String?

  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, sortOrder])
}

model ProductAttribute {
  id        String @id @default(uuid())
  productId String

  name      String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  values ProductAttributeValue[]

  @@unique([productId, name])
  @@index([productId])
}

model ProductAttributeValue {
  id          String @id @default(uuid())
  attributeId String

  value     String
  sortOrder Int    @default(0)

  // Optional image for this specific value.
  // Useful for color swatches.
  imageStorageKey String?
  imageUrl        String?

  attribute ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  variantValues ProductVariantValue[]

  @@unique([attributeId, value])
  @@index([attributeId])
}

model ProductVariant {
  specialOrderRequestItems SpecialOrderRequestItem[]

  id        String @id @default(uuid())
  productId String

  sku String @unique

  // null = use Product.basePrice
  price Decimal? @db.Decimal(14, 4)

  taxCategoryId String?

  isActive Boolean @default(true)

  // True only for the canonical/default variant of a product.
  //
  // Products with selectable options:
  //   isDefault = false for all selectable variants.
  //
  // Products without selectable options:
  //   exactly one variant isDefault = true.
  isDefault Boolean @default(false)

  // Variant-level discount.
  discountType     DiscountType?
  discountValue    Decimal?      @db.Decimal(14, 4)
  discountStartsAt DateTime?
  discountEndsAt   DateTime?

  /**
   * Canonical combination of attribute-value IDs.
   * Example:
   * Color Red + Size M
   * combinationKey:
   * color-value-id:size-value-id
   * IDs are sorted before creating the key.
   */
  combinationKey String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  values ProductVariantValue[]

  images ProductVariantImage[]

  inventory Inventory[]

  cartItems CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taxCategory TaxCategory? @relation(fields: [taxCategoryId], references: [id], onDelete: Restrict)

  @@unique([productId, combinationKey])
  @@index([productId])
  @@index([isActive])
  @@index([productId, isDefault])

  promotionSelectors PromotionSelector[]

  @@unique([productId, id])
}

model ProductVariantValue {
  variantId        String
  attributeValueId String

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  attributeValue ProductAttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
  @@index([attributeValueId])
}

model ProductVariantImage {
  id        String @id @default(uuid())
  variantId String

  storageKey String
  url        String
  altText    String?

  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([variantId, sortOrder])
}

model Inventory {
  id        String @id @default(uuid())
  variantId String
  tenantId String
  warehouseId String

  quantity         Int @default(0)
  reservedQuantity Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  transactions InventoryTransaction[]
  sourcingEntries SpecialOrderSourcingEntry[]
  warehouse Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)

  @@unique([warehouseId, variantId])
  @@index([tenantId, variantId])
}

model InventoryTransaction {
  id          String @id @default(uuid())
  inventoryId String

  type InventoryTransactionType

  quantity Int

  referenceId String?
  reason      String?

  createdAt DateTime @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([inventoryId, type, referenceId])
  @@index([inventoryId])
  @@index([type])
  @@index([createdAt])
  @@index([referenceId])
}

model Cart {
  id       String @id @default(uuid())
  tenantId String
  userId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  items CartItem[]

  @@unique([tenantId, userId])
  @@index([tenantId])
}

model CartItem {
  id String @id @default(uuid())

  cartId    String
  variantId String

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Coupon {
  id String @id @default(uuid())

  tenantId String

  code String

  discountType  CouponDiscountType
  discountValue Decimal            @db.Decimal(14, 4)

  minimumOrderAmount    Decimal? @db.Decimal(14, 4)
  maximumDiscountAmount Decimal? @db.Decimal(14, 4)

  startsAt DateTime?
  endsAt   DateTime?

  usageLimit Int?
  usageCount Int  @default(0)

  perUserLimit Int?

  isActive Boolean @default(true)

  tenant Tenant @relation( fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
  usages CouponUsage[]

  @@unique([tenantId, code])

  @@index([tenantId])
  @@index([tenantId, isActive])
}

model CouponUsage {
  id String @id @default(uuid())

  couponId String
  userId   String
  orderId  String @unique

  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([couponId, userId])
  @@index([userId])
  @@index([couponId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  COMPLETED
}

model Order {
  warehouseId String?
  fulfillmentSnapshot Json?
  warehouse Warehouse? @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  id String @id @default(uuid())

  tenantId String

  // Null for legacy/COD orders: never infer an expiration from createdAt.
  reservationExpiresAt DateTime? @db.Timestamptz(3)
  recoveryJob RecoveryJob?

  orderNumber String

  userId String

  couponId String?

  // Null for legacy orders or checkouts without a coupon.
  couponSnapshot Json?

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  payments Payment[]

  currency String @default("USD")

  subtotal       Decimal @db.Decimal(14, 4)
  discountAmount Decimal @db.Decimal(14, 4)
  shippingAmount Decimal @db.Decimal(14, 4)
  taxAmount      Decimal @db.Decimal(14, 4)
  totalAmount    Decimal @db.Decimal(14, 4)

  taxCountryCode String?
  taxRegionCode  String?

  pricesIncludeTax Boolean @default(false)

  // Snapshot of the tax configuration used at checkout.
  taxProfileSnapshot Json?

  shippingMethodId String?
  shippingMethodCode String?
  shippingMethodName String?
  shippingRuleId String?
  shippingProfileSnapshot Json?

  shippingDistanceKm Decimal? @db.Decimal(10, 2)

  shippingAddress Json
  billingAddress  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation( fields: [tenantId], references: [id],  onDelete: Restrict)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  items OrderItem[]

  statusHistory OrderStatusHistory[]

  couponUsage CouponUsage?

  checkoutRequests CheckoutRequest[]

  paymentRefunds PaymentRefund[]
  paymentRefundConflicts PaymentRefundConflictAudit[]
  refundWebhookEvents MyFatoorahRefundWebhookEvent[]

  @@unique([tenantId, id])
  @@index([status, reservationExpiresAt])
  @@index([tenantId])
@@index([tenantId, userId])
@@index([tenantId, createdAt])
@@index([tenantId, status])
@@index([tenantId, paymentStatus])
@@index([tenantId, paymentStatus, createdAt(sort: Desc), status])
@@unique([tenantId, orderNumber])
  @@index([couponId])
  @@index([createdAt])
  @@index([paymentStatus])
  @@index([status])
  @@index([userId, createdAt])
  @@index([userId])

  promotionRedemptions PromotionRedemption[]

  @@unique([tenantId, id, userId])
}

model OrderItem {
  id String @id @default(uuid())

  orderId   String
  productId String
  variantId String

  productName String
  sku         String

  quantity Int

  unitPrice Decimal @db.Decimal(14, 4)

  itemDiscountAmount Decimal @db.Decimal(14, 4)

  finalUnitPrice Decimal @db.Decimal(14, 4)

  totalPrice Decimal @db.Decimal(14, 4)

  taxCategoryCode String?
  taxCategoryId String?
  taxRuleId String?
  taxTreatment    TaxTreatment?

  taxRate Decimal? @db.Decimal(5, 2)

  taxableAmount Decimal @db.Decimal(14, 4)
  taxAmount     Decimal @db.Decimal(14, 4)

  // JSON snapshot of Color, Size, etc.
  variantSnapshot Json

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([productId, orderId])
  @@index([orderId, productId])

  promotionAllocations PromotionAllocation[]

  @@unique([orderId, id])
}

model OrderStatusHistory {
  id String @id @default(uuid())

  orderId String

  fromStatus OrderStatus?
  toStatus   OrderStatus

  changedByUserId String?

  reason String?

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  CARD
  DIGITAL_WALLET
  BANK_TRANSFER
}

enum PaymentProvider {
  NONE
  STRIPE
  PAYMOB
  MYFATOORAH
}

enum PaymentInitiationState {
  NOT_STARTED
  IN_PROGRESS
  INITIATED
  UNKNOWN
}

model Payment {
  id String @id @default(uuid())

  orderId String

  provider PaymentProvider
  method   PaymentMethod
  status   PaymentStatus   @default(PENDING)

  amount   Decimal @db.Decimal(14, 4)
  currency String

  // UNKNOWN protects legacy records whose external outcome cannot be inferred.
  initiationState PaymentInitiationState @default(UNKNOWN)

  providerPaymentId     String?
  providerTransactionId String?

  providerAccountId   String?
  providerEnvironment PaymentProviderEnvironment?

  failureCode    String?
  failureMessage String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  providerAccount PaymentProviderAccount? @relation(fields: [providerAccountId, provider, providerEnvironment], references: [id, provider, environment], onDelete: Restrict, onUpdate: Restrict)
  reconciliationRequired Boolean @default(false)
  reconciliationReason String?
  reconciliationFlaggedAt DateTime? @db.Timestamptz(3)
  myFatoorahInvoice MyFatoorahInvoice?
  myFatoorahEvents MyFatoorahWebhookEvent[]
  refunds PaymentRefund[]
  refundConflicts PaymentRefundConflictAudit[]
  refundWebhookEvents MyFatoorahRefundWebhookEvent[]

  @@unique([orderId, id])
  @@unique([orderId, id, providerAccountId, providerEnvironment])
  @@index([provider, status, initiationState])
  @@index([providerAccountId, providerEnvironment, providerPaymentId])
  @@index([orderId])
  @@index([status])
  @@index([provider])
  @@index([providerPaymentId])
  @@index([providerTransactionId])
}

model ProductCollection {
  id          String  @id @default(uuid())
  tenantId    String
  name        String
  slug        String
  description String?

  imageStorageKey String?
  imageUrl        String?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  startsAt DateTime?
  endsAt   DateTime?

  products ProductCollectionItem[]
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@index([sortOrder])
  @@index([isActive])
}

model ProductCollectionItem {
  collectionId String
  productId    String

  sortOrder Int @default(0)

  collection ProductCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

model Wishlist {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@unique([tenantId, userId])
  @@index([tenantId])
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@index([productId])
}

enum BannerTargetType {
  NONE
  PRODUCT
  CATEGORY
  COLLECTION
  EXTERNAL_URL
}

model Banner {
  id String @id @default(uuid())

  tenantId String

  title    String?
  subtitle String?

  imageStorageKey String
  imageUrl        String

  mobileImageStorageKey String?
  mobileImageUrl        String?

  targetType BannerTargetType @default(NONE)
  targetId   String?
  actionUrl  String?

  sortOrder Int @default(0)

  startsAt DateTime?
  endsAt   DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, sortOrder])
  @@index([tenantId, startsAt])
  @@index([tenantId, endsAt])
  @@index([endsAt])
  @@index([isActive])
  @@index([sortOrder])
  @@index([startsAt])
}

model Address {
  id String @id @default(uuid())

  userId String

  label String?

  firstName String
  lastName String
  company String?

  addressLine1 String
  addressLine2 String?

  city String
  state String?
  postalCode String?

  countryCode String

  phone String?

  latitude Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  isDefaultShipping Boolean @default(false)
  isDefaultBilling Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  country Country @relation(fields: [countryCode], references: [code], onDelete: Restrict)

  @@index([userId])
  @@index([userId, isDefaultShipping])
  @@index([userId, isDefaultBilling])
  @@index([countryCode])
}

model CheckoutRequest {
  id String @id @default(uuid())

  // Nullable only for legacy records whose tenant cannot be recovered.
  tenantId String?
  requestFingerprint String?

  userId String

  idempotencyKey String

  orderId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId, idempotencyKey])
  @@index([orderId])
}

model AppSetting {
  id          String   @id @default(uuid())
  tenantId String

  key         String
  value       Json
  description String?
  isPublic    Boolean  @default(true)

  tenant Tenant @relation( fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, key])

  @@index([tenantId])
  @@index([tenantId, isPublic])
  @@index([isPublic])
}

model ProductReview {
  id         String   @id @default(uuid())
  productId  String
  userId     String
  rating     Int
  title      String?
  comment    String?
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@index([productId, isApproved])
  @@index([createdAt])
}

enum NotificationScope {
  TENANT
  ACCOUNT
}

enum NotificationType {
  ORDER
  PAYMENT
  SHIPPING
  PROMOTION
  SYSTEM
  REVIEW
}

