enum PaymentRefundConflictResolutionState {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model PaymentRefundConflictAudit {
  id String @id @default(uuid())

  tenantId       String?
  paymentId      String?
  orderId        String?
  refundId       String?
  attemptId      String?
  webhookEventId String?

  provider            PaymentProvider
  providerAccountId   String?
  providerEnvironment PaymentProviderEnvironment?

  source          PaymentRefundConflictSource
  conflictType    PaymentRefundConflictType
  resolutionState PaymentRefundConflictResolutionState @default(OPEN)

  expectedRefundStatus    PaymentRefundStatus?
  observedExternalStatus  String?
  expectedAmount          Decimal? @db.Decimal(14, 4)
  observedAmount          Decimal? @db.Decimal(14, 4)
  currency                String?
  providerRefundId        String?
  providerRefundReference String?

  summary          String
  sanitizedDetails Json?

  detectedAt       DateTime  @default(now()) @db.Timestamptz(3)
  resolvedAt       DateTime? @db.Timestamptz(3)
  resolvedByUserId String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant          Tenant?                       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order           Order?                        @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  payment         Payment?                      @relation(fields: [orderId, paymentId], references: [orderId, id], onDelete: Restrict, onUpdate: Restrict)
  refund          PaymentRefund?                @relation(fields: [tenantId, orderId, paymentId, refundId], references: [tenantId, orderId, paymentId, id], onDelete: Restrict, onUpdate: Restrict)
  attempt         PaymentRefundAttempt?         @relation(fields: [attemptId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  webhookEvent    MyFatoorahRefundWebhookEvent? @relation(fields: [webhookEventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  providerAccount PaymentProviderAccount?       @relation(fields: [providerAccountId, provider, providerEnvironment], references: [id, provider, environment], onDelete: Restrict, onUpdate: Restrict)
  resolvedBy      User?                         @relation("PaymentRefundConflictResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([resolutionState, detectedAt])
  @@index([tenantId, resolutionState, detectedAt])
  @@index([tenantId, orderId, paymentId])
  @@index([refundId, detectedAt])
  @@index([providerAccountId, conflictType, detectedAt])
}

