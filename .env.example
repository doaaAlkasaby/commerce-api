NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

DATABASE_URL="postgresql://commerce_user:commerce_password@localhost:5432/commerce_api?schema=public"
TEST_DATABASE_URL="postgresql://commerce_test_user:commerce_test_password@localhost:5433/commerce_api_test?schema=public"


CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

BODY_LIMIT=1mb

TRUST_PROXY=false

ENABLE_API_DOCS=false

# to create a new secret, you can use the following command in your terminal:openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-a-unique-random-secret-at-least-32-characters"
JWT_ACCESS_EXPIRES_IN="15m"

REFRESH_TOKEN_EXPIRES_DAYS=30

EMAIL_VERIFICATION_EXPIRES_HOURS=24

# File delivery is development/test only. Tokens never enter logs or HTTP responses.
EMAIL_DELIVERY_MODE=disabled
# EMAIL_DELIVERY_MODE=development_file
# EMAIL_DEVELOPMENT_OUTBOX_DIR=/tmp/commerce-api-development-mail

# Explicitly approve only a local development/test database; never production.
ALLOW_DEVELOPMENT_SEED=false
# DEVELOPMENT_SEED_DATABASE=commerce_api_dev
# DEVELOPMENT_SEED_PASSWORD=<provide a private development-only strong password>

PASSWORD_RESET_EXPIRES_HOURS=1

UPLOAD_DIR="./uploads"
UPLOAD_BASE_URL="http://localhost:3000/uploads"

MAX_IMAGE_SIZE_MB=5

# Pool sizes apply per application process. Keep headroom for migrations/operations.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=30000
# Local development may use plaintext. Production requires verified TLS.
# Prefer DATABASE_URL with sslmode=verify-full for both Prisma CLI and the API.
DB_SSL_MODE=url
# Alternative for the API only: DB_SSL_MODE=verify-full, without URL TLS parameters.
# DB_SSL_CA_FILE=/run/secrets/postgres-ca.pem

# MyFatoorah Kuwait hosted invoice integration. NONE preserves local payments.
PAYMENT_PROVIDER=NONE
# Selecting MYFATOORAH requires all values below; never put real secrets in git.
# MYFATOORAH_ENV=sandbox
# MYFATOORAH_API_VERSION=v2
# Confirm the token account in the portal before setting these attestations:
# MYFATOORAH_ACCOUNT_COUNTRY=KWT
# MYFATOORAH_ACCOUNT_CURRENCY=KWD
# MYFATOORAH_API_TOKEN=
# MYFATOORAH_WEBHOOK_SECRET=
# MYFATOORAH_CALLBACK_URL=https://api.example.com/api/v1/payment-providers/myfatoorah/callback
# MYFATOORAH_ERROR_URL=https://api.example.com/api/v1/payment-providers/myfatoorah/error
# MYFATOORAH_TIMEOUT_MS=10000

# Phase 4: standalone PostgreSQL recovery worker (never started by HTTP)
RESERVATION_TTL_SECONDS=900
WORKER_POLL_MS=1000
WORKER_CONCURRENCY=2
WORKER_SCAN_BATCH=100
WORKER_LEASE_MS=60000
WORKER_MAX_ATTEMPTS=12
WORKER_RETRY_BASE_MS=5000
WORKER_RETRY_MAX_MS=900000
WORKER_INITIATION_GRACE_MS=120000

# Shared request budgets use PostgreSQL automatically in production (migration 16).
RATE_LIMIT_STORE=auto
# Prefer exact trusted proxy networks; leave unset for direct connections.
# TRUST_PROXY_CIDRS=127.0.0.1/32,::1/128
# Opt in only after an authentication-token rollout: existing tokens have no issuer/audience.
# JWT_ISSUER=https://api.example.com
# JWT_AUDIENCE=commerce-mobile

# Phase 6 operational metrics: unset disables metrics, probes remain minimal.
# Generate a separate 32-256 character base64url token; never reuse JWT/provider keys.
# OPS_METRICS_TOKEN=
# Optional private worker-only operational listener (0 disables).
WORKER_OPS_PORT=0
OPS_BIND_HOST=127.0.0.1
